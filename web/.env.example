# Copy to .env.local and fill in. Never commit real values.

# Sanity project (public; safe in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=yqc9zm5m
NEXT_PUBLIC_SANITY_DATASET=production

# Public site address, used for canonical links and social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets (NO NEXT_PUBLIC_ prefix, never expose to the browser)
# Read token: only needed for draft content / Visual Editing. Viewer role.
SANITY_API_READ_TOKEN=
# Write token: REQUIRED for the contact form to store enquiries. Editor role.
# Create at sanity.io/manage -> your project -> API -> Tokens.
SANITY_API_WRITE_TOKEN=
